RunService.RenderStepped:Connect(function(dt)
	elapsedClock = elapsedClock + ((isFiniteNumber(dt) and dt > 0) and math.min(dt, 0.1) or 0.016)

	local cam = Workspace.CurrentCamera
	fovCircle.Visible = Config.Enabled and Config.ShowFOV and (cam ~= nil)

	if not Config.Enabled or not cam then
		lineFrame.Visible = false
		infoTag.Visible = false
		return
	end

	local vp = cam.ViewportSize
	local centerX = vp.X * 0.5
	local centerY = vp.Y * 0.5
	local originPos = getOriginPosition(cam)

	local targetPart, aimPos, worldDist, blocked = findBestSilentTarget(cam, originPos, centerX, centerY, elapsedClock)
	if targetPart and aimPos and isFiniteVector3(aimPos) then
		local sp, onScreen = cam:WorldToViewportPoint(aimPos)
		if onScreen and isFiniteNumber(sp.Z) and sp.Z > 0 then
			local col = blocked and Color3.fromRGB(245, 248, 255) or Color3.fromRGB(0, 255, 140)
			if Config.ShowLine then
				local dx = sp.X - centerX
				local dy = sp.Y - centerY
				local dist2D = math.sqrt(dx * dx + dy * dy)
				if dist2D > 1 then
					lineFrame.Size = UDim2.new(0, dist2D, 0, 2)
					lineFrame.Position = UDim2.new(0, (centerX + sp.X) * 0.5, 0, (centerY + sp.Y) * 0.5)
					lineFrame.Rotation = math.deg(math.atan2(dy, dx))
					lineFrame.BackgroundColor3 = col
					lineFrame.Visible = true
				else
					lineFrame.Visible = false
				end
			else
				lineFrame.Visible = false
			end

			if Config.ShowEspInfo and targetPart.Parent then
				infoTag.Text = string.format("%s | %.0fm", targetPart.Parent.Name, worldDist)
				infoTag.TextColor3 = col
				infoTag.Position = UDim2.new(0, sp.X, 0, sp.Y - 18)
				infoTag.Visible = true
			else
				infoTag.Visible = false
			end
			return
		end
	end

	lineFrame.Visible = false
	infoTag.Visible = false
end)
