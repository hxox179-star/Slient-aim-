local function getCharacterStanceText(model, hum, hrp, head)
	local bodyPart = (hrp and hrp:IsA("BasePart") and hrp)
		or (model and (model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")))
		or (head and head:IsA("BasePart") and head)
		or nil

	if bodyPart and bodyPart:IsA("BasePart") and isFiniteVector3(bodyPart.CFrame.UpVector) then
		local upDot = math.abs(bodyPart.CFrame.UpVector:Dot(Vector3.new(0, 1, 0)))
		if upDot < 0.42 then
			return "Nằm"
		end
	end

	if hum then
		local okState, state = pcall(function() return hum:GetState() end)
		if okState and state then
			if state == Enum.HumanoidStateType.Seated or state == Enum.HumanoidStateType.PlatformStanding then
				return "Ngồi"
			end
		end
		if hum.Sit or (hum.SeatPart and hum.SeatPart:IsA("BasePart")) then
			return "Ngồi"
		end
		local hip = tonumber(hum.HipHeight)
		if hip and hip > 0.1 and hip < 1.15 then
			return "Ngồi"
		end
	end

	return "Đứng"
end

local function isGhostOrNonSolidPart(inst)
	if not inst or not inst:IsA("BasePart") then return false end
	local model = inst:FindFirstAncestorOfClass("Model")
	if model and model:FindFirstChildOfClass("Humanoid") then
		return false
	end
	if inst.Transparency >= 0.92 then
		return true
	end
	if inst.CanCollide == false and inst.CanQuery == false then
		return true
	end
	return false
end

local function checkWallOcclusion(model, targetPart, aimPos, hum)
	local bypassWall = isTargetOnVehicleOrMovingPlatform(model, targetPart, hum)
	if bypassWall then return false, true end

	local cam = Workspace.CurrentCamera
	if not cam or not isFiniteVector3(cam.CFrame.Position) then return false, false end

	local origin = cam.CFrame.Position
	local goalPos = (aimPos and isFiniteVector3(aimPos)) and aimPos or targetPart.Position
	local direction = goalPos - origin
	if not isFiniteVector3(direction) or direction.Magnitude <= 0.001 then return false, false end

	SharedWallParams.FilterDescendantsInstances = { LocalPlayer.Character, model }
	local ok, result = pcall(function()
		return Workspace:Raycast(origin, direction, SharedWallParams)
	end)
	if not ok or not result or not result.Instance then return false, false end
	if isGhostOrNonSolidPart(result.Instance) then return false, false end
	return true, false
end

local function isClearPathWithWallFlag(model, targetPart, aimPos, hum, wallFlag)
	if not wallFlag then return true end
	local isBlocked, bypassWall = checkWallOcclusion(model, targetPart, aimPos, hum)
	if bypassWall then return true end
	return not isBlocked
end

local function rebuildPlayerCharacterSet()
	table.clear(PlayerCharacterSet)
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Character then
			PlayerCharacterSet[player.Character] = true
		end
	end
end

local function isEnemyPlayer(player)
	if player == LocalPlayer then return false end
	if Config.TeamCheck and LocalPlayer.Team and player.Team == LocalPlayer.Team then return false end
	local char = player.Character
	if not char or not char.Parent or char == LocalPlayer.Character then return false end
	local hum = char:FindFirstChildOfClass("Humanoid")
	return hum ~= nil and hum.Health > 0
end

local function updateESPVisuals(cam, originPos)
	if not ESPContainer or not cam or not isFiniteVector3(cam.CFrame.Position) then
		hideUnusedEspEntries(1)
		return
	end
	if not Config.ESPEnabled or (not Config.ESPBox and not Config.ESPHealthBar and not Config.ESPDistance and not Config.ESPStanceLabel) then
		hideUnusedEspEntries(1)
		return
	end

	ESPContainer.Visible = true
	local maxEspDist = math.clamp(tonumber(Config.ESPMaxDistance) or 350, 150, 1500)
	local vp = cam.ViewportSize
	if vp.X <= 0 or vp.Y <= 0 then
		hideUnusedEspEntries(1)
		return
	end

	local candidates = {}
	local seenModels = {}
	if shouldTargetPlayers() or shouldTargetNpcs() then
		rebuildPlayerCharacterSet()
	end

	if shouldTargetPlayers() then
		for _, player in ipairs(Players:GetPlayers()) do
			if isEnemyPlayer(player) then
				local char = player.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if char and hum and hum.Health > 0 and not seenModels[char] then
					seenModels[char] = true
					table.insert(candidates, { model = char, hum = hum })
				end
			end
		end
	end

	if shouldTargetNpcs() then
		for _, entry in ipairs(CachedNpcEntries) do
			local npcModel = entry.model
			local hum = entry.hum
			if npcModel and npcModel.Parent and not PlayerCharacterSet[npcModel] and npcModel ~= LocalPlayer.Character and hum and hum.Parent and hum.Health > 0 and not seenModels[npcModel] then
				seenModels[npcModel] = true
				table.insert(candidates, { model = npcModel, hum = hum })
			end
		end
		for _, obj in ipairs(Workspace:GetChildren()) do
			if obj:IsA("Model") and not PlayerCharacterSet[obj] and obj ~= LocalPlayer.Character and not seenModels[obj] then
				local hum = obj:FindFirstChildOfClass("Humanoid")
				if hum and hum.Health > 0 then
					seenModels[obj] = true
					table.insert(candidates, { model = obj, hum = hum })
				end
			end
		end
	end

	local visualIndex = 0
	for _, item in ipairs(candidates) do
		local model = item.model
		local hum = item.hum
		local hrp = model:FindFirstChild("HumanoidRootPart")
		local head = model:FindFirstChild("Head")
		local anchor = (hrp and hrp:IsA("BasePart") and hrp) or (head and head:IsA("BasePart") and head) or nil

		if anchor and isFiniteVector3(anchor.Position) then
			local distStuds = (anchor.Position - originPos).Magnitude
			local distMeters = studsToMeters(distStuds)

			if distStuds <= maxEspDist or distMeters <= maxEspDist then
				local boxLeft, boxTop, boxW, boxH
				local hasValidBox = false

				if Config.ESPFixedSize then
					local centerScreen, onScreen = cam:WorldToViewportPoint(anchor.Position)
					local rx, ry, rz = centerScreen.X, centerScreen.Y, centerScreen.Z
					if onScreen and isFiniteNumber(rx) and isFiniteNumber(ry) and isFiniteNumber(rz) and rz > 0 then
						boxW = FIXED_ESP_BOX_WIDTH
						boxH = FIXED_ESP_BOX_HEIGHT
						boxLeft = math.floor(rx - boxW * 0.5)
						boxTop = math.floor(ry - boxH * 0.5)
						hasValidBox = true
					end
				else
					local topWorld = (head and head:IsA("BasePart") and isFiniteVector3(head.Position))
						and (head.Position + Vector3.new(0, head.Size.Y * 0.5 + 0.45, 0))
						or (anchor.Position + Vector3.new(0, 2.8, 0))
					local bottomWorld = anchor.Position - Vector3.new(0, 3.1, 0)

					local topScreen = cam:WorldToViewportPoint(topWorld)
					local botScreen = cam:WorldToViewportPoint(bottomWorld)

					local topX, topY, topZ = topScreen.X, topScreen.Y, topScreen.Z
					local botX, botY, botZ = botScreen.X, botScreen.Y, botScreen.Z

					if isFiniteNumber(topX) and isFiniteNumber(topY) and isFiniteNumber(topZ)
						and isFiniteNumber(botX) and isFiniteNumber(botY) and isFiniteNumber(botZ)
						and (topZ > 0 or botZ > 0) then

						if topZ < 0 then
							topY = math.clamp(vp.Y - topY, 0, vp.Y)
							topX = math.clamp(vp.X - topX, 0, vp.X)
						end
						if botZ < 0 then
							botY = math.clamp(vp.Y - botY, 0, vp.Y)
							botX = math.clamp(vp.X - botX, 0, vp.X)
						end

						local boxHeight = math.clamp(math.abs(botY - topY), 16, vp.Y * 0.9)
						local boxWidth = math.clamp(boxHeight * 0.56, 12, vp.X * 0.6)
						local centerX = (topX + botX) * 0.5
						local minY = math.min(topY, botY)
						boxLeft = math.floor(centerX - boxWidth * 0.5)
						boxTop = math.floor(minY)
						boxW = math.floor(boxWidth)
						boxH = math.floor(boxHeight)
						hasValidBox = true
					end
				end

				if hasValidBox then
					visualIndex = visualIndex + 1
					local entry = getOrCreateEspEntry(visualIndex)
					if entry then
						local isBlocked = false
						if Config.ESPWallCheck then
							local blockedFlag = checkWallOcclusion(model, anchor, anchor.Position, hum)
							isBlocked = blockedFlag
						end
						local boxColor = isBlocked and COLOR_ESP_WALL_WHITE or COLOR_ESP_CLEAR_GREEN
						local stanceText = getCharacterStanceText(model, hum, hrp, head)

						if entry.box then
							if Config.ESPBox then
								entry.box.Position = UDim2.new(0, boxLeft, 0, boxTop)
								entry.box.Size = UDim2.new(0, boxW, 0, boxH)
								if entry.stroke then
									entry.stroke.Color = boxColor
								end
								entry.box.Visible = true
							else
								entry.box.Visible = false
							end
						end

						if entry.stance then
							if Config.ESPStanceLabel then
								entry.stance.Text = stanceText
								entry.stance.Position = UDim2.new(0, boxLeft - 14, 0, boxTop - 16)
								entry.stance.Size = UDim2.new(0, boxW + 28, 0, 14)
								entry.stance.Visible = true
							else
								entry.stance.Visible = false
							end
						end

						if entry.hpBg and entry.hpFill then
							if Config.ESPHealthBar then
								local maxHp = math.max(1, tonumber(hum.MaxHealth) or 100)
								local hpRatio = math.clamp((tonumber(hum.Health) or 0) / maxHp, 0, 1)
								local barW = 4
								local barLeft = boxLeft - barW - 3
								entry.hpBg.Position = UDim2.new(0, barLeft, 0, boxTop)
								entry.hpBg.Size = UDim2.new(0, barW, 0, boxH)
								entry.hpFill.Size = UDim2.new(1, 0, hpRatio, 0)
								entry.hpFill.Position = UDim2.new(0, 0, 1 - hpRatio, 0)
								entry.hpFill.BackgroundColor3 = getHealthColor(hpRatio)
								entry.hpBg.Visible = true
							else
								entry.hpBg.Visible = false
							end
						end

						if entry.dist then
							if Config.ESPDistance then
								entry.dist.Text = tostring(distMeters) .. "m"
								entry.dist.Position = UDim2.new(0, boxLeft, 0, boxTop + boxH + 2)
								entry.dist.Size = UDim2.new(0, boxW, 0, 14)
								entry.dist.Visible = true
							else
								entry.dist.Visible = false
							end
						end
					end
				end
			end
		end
	end

	hideUnusedEspEntries(visualIndex + 1)
end

