		end

		if elapsedClock - lastEspRenderTime >= 0.033 then
			lastEspRenderTime = elapsedClock
			renderEspForModels(cam, originPos)
		end

		if Config.DebugLog then
			local currentDesc = CachedTarget and (CachedTarget.Parent.Name .. "." .. CachedTarget.Name) or (CachedChestTarget and ("Chest:" .. CachedChestTarget.Parent.Name) or "NONE")
			if currentDesc ~= lastLoggedTargetName then
				lastLoggedTargetName = currentDesc
				logDebug(string.format("Target: %s | Dist: %.1f | Vel: %.1f", currentDesc, CachedDistance, CachedTargetVelocity.Magnitude))
			end
		end
	end)
end)

local function aimDirection(origin, originalDirection, targetPos)
	if not (isFiniteVector3(origin) and isFiniteVector3(targetPos)) then return originalDirection end
	local toTarget = targetPos - origin
	if not isFiniteVector3(toTarget) or toTarget.Magnitude <= 1e-4 then return originalDirection end
	local mag = (isFiniteVector3(originalDirection) and originalDirection.Magnitude > 0) and originalDirection.Magnitude or toTarget.Magnitude
	local dir = toTarget.Unit * mag
	return isFiniteVector3(dir) and dir or originalDirection
end

local function logHookHit(tag)
	if not Config.DebugLog then return end
	if elapsedClock - lastHookLogTime >= 0.5 then
		lastHookLogTime = elapsedClock
		logDebug("Hook kich hoat: " .. tag)
	end
end

local function safeHookMetamethod(target, metamethod, handler)
	if type(hookmetamethod) == "function" then
		local ok, oldFn = pcall(hookmetamethod, target, metamethod, handler)
		if ok and oldFn then return oldFn end
	end
	if type(getrawmetatable) == "function" and type(setreadonly) == "function" then
		local ok, mt = pcall(getrawmetatable, target)
		if ok and type(mt) == "table" and type(mt[metamethod]) == "function" then
			local oldFn = mt[metamethod]
			local okSet = pcall(setreadonly, mt, false)
			if okSet then
				local okAssign = pcall(function()
					mt[metamethod] = function(...) return handler(...) end
				end)
				pcall(setreadonly, mt, true)
				if okAssign then return oldFn end
			end
		end
	end
	return nil
end

local SUSPICIOUS_REMOTE_PATTERNS = {
	"kick", "ban", "anticheat", "anti_cheat", "ac_", "flag", "report",
	"exploit", "cheat", "detect", "security", "sanity", "telemetry", "violation"
}

local function isSuspiciousClientRemote(inst)
	if not inst or not (inst:IsA("RemoteEvent") or inst:IsA("RemoteFunction") or inst:IsA("BindableEvent") or inst:IsA("BindableFunction")) then
		return false
	end
	local lowerName = string.lower(inst.Name or "")
	for _, pat in ipairs(SUSPICIOUS_REMOTE_PATTERNS) do
		if string.find(lowerName, pat, 1, true) then
			return true
		end
	end
	return false
end

