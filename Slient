pcall(function()
	if not getnamecallmethod then
		warn("[SilentAimGemini] Executor khong ho tro getnamecallmethod.")
		return
	end
	local oldNamecall
	oldNamecall = safeHookMetamethod(game, "__namecall", function(self, ...)
		local okMethod, method = pcall(getnamecallmethod)
		if okMethod then
			if Config.AntiKickClient then
				if method == "Kick" and self == LocalPlayer then
					logHookHit("Blocked __namecall Kick")
					return nil
				end
				if (method == "FireServer" or method == "InvokeServer") and isSuspiciousClientRemote(self) then
					if not isCallerOwnScript() then
						logHookHit("Blocked suspicious remote: " .. tostring(self.Name))
						return nil
					end
				end
			end

			if isSilentActive() and self == Workspace and CachedTarget then
				local aimPoint = getActiveSilentAimPoint()
				if aimPoint and (method == "Raycast" or method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist") then
					if not isCallerOwnScript() then
						if method == "Raycast" then
							local args = { ... }
							local origin, direction = args[1], args[2]
							if isFiniteVector3(origin) and isFiniteVector3(direction) then
								args[2] = aimDirection(origin, direction, aimPoint)
								logHookHit("Workspace:Raycast")
								return oldNamecall(self, table.unpack(args))
							end
						else
							local args = { ... }
							local ray = args[1]
							if typeof(ray) == "Ray" and isFiniteVector3(ray.Origin) and isFiniteVector3(ray.Direction) then
								args[1] = Ray.new(ray.Origin, aimDirection(ray.Origin, ray.Direction, aimPoint))
								logHookHit("Workspace:" .. method)
								return oldNamecall(self, table.unpack(args))
							end
						end
					end
				end
			end
		end
		return oldNamecall(self, ...)
	end)
end)

pcall(function()
	local Mouse = LocalPlayer:GetMouse()
	if Mouse then
		local oldIndex
		oldIndex = safeHookMetamethod(Mouse, "__index", function(self, key)
			if isSilentActive() and self == Mouse and CachedTarget then
				local aimPoint = getActiveSilentAimPoint()
				if aimPoint and (key == "Hit" or key == "Target" or key == "UnitRay") and (not isCallerOwnScript()) then
					if key == "Hit" then
						logHookHit("Mouse.Hit")
						return CFrame.new(aimPoint)
					elseif key == "Target" then
						logHookHit("Mouse.Target")
						return CachedTarget
					elseif key == "UnitRay" then
						local cam = Workspace.CurrentCamera
						if cam and isFiniteVector3(cam.CFrame.Position) then
							local origin = cam.CFrame.Position
							local delta = aimPoint - origin
							if isFiniteVector3(delta) and delta.Magnitude > 1e-5 then
								logHookHit("Mouse.UnitRay")
								return Ray.new(origin, delta.Unit)
							end
						end
					end
				end
			end
			return oldIndex(self, key)
		end)
	end
end)
