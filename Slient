local function estimateTargetVelocity(part, dt, distance)
	if not part or not part:IsA("BasePart") or not isFiniteVector3(part.Position) then
		return Vector3.zero
	end
	local currentPos = part.Position
	local assemblyVel = part.AssemblyLinearVelocity
	if not isFiniteVector3(assemblyVel) then assemblyVel = Vector3.zero end
	local estimatedVel = assemblyVel

	if prevTargetPart == part and prevTargetPos and prevSampleTime and dt > 0.001 then
		local frameVel = (currentPos - prevTargetPos) / dt
		if isFiniteVector3(frameVel) and frameVel.Magnitude < 160 then
			local blend = 0.65
			estimatedVel = (assemblyVel.Magnitude > 1 and frameVel.Magnitude > 1) and assemblyVel:Lerp(frameVel, blend) or frameVel
		end
	end

	prevTargetPart = part
	prevTargetPos = currentPos
	prevTargetVel = estimatedVel
	prevSampleTime = elapsedClock
	return isFiniteVector3(estimatedVel) and estimatedVel or Vector3.zero
end

local function computePredictedPosition(origin, part, velocity)
	if not part or not isFiniteVector3(part.Position) then return nil end
	local basePos = part.Position
	if Config.StraightBullet or not Config.AutoSmartAim or not isFiniteVector3(origin) then
		return basePos
	end
	local dist = (basePos - origin).Magnitude
	local moveSpeed = isFiniteVector3(velocity) and velocity.Magnitude or 0
	if moveSpeed < 2.5 then return basePos end

	local nearScale = math.clamp((dist - 18) / 45, 0, 1)
	if nearScale <= 0.05 then return basePos end

	local effectiveSpeed = math.max(350, tonumber(Config.BulletSpeed) or 950)
	local rawLead = dist / effectiveSpeed
	local maxLead = math.min(tonumber(Config.MaxLeadTime) or 0.24, 0.22)
	local leadTime = math.clamp(rawLead * nearScale * 0.75, 0, maxLead)

	local predicted = basePos + (velocity * leadTime)
	if (predicted - basePos).Magnitude > 4.5 then
		predicted = basePos + (predicted - basePos).Unit * 4.5
	end
	return isFiniteVector3(predicted) and predicted or basePos
end

local function isWithinMaxDistance(origin, part, customMaxMeters)
	if not part or not isFiniteVector3(part.Position) then return true end
	local distStuds = (part.Position - origin).Magnitude
	local distMeters = studsToMeters(distStuds)

	if customMaxMeters ~= nil then
		return distMeters <= customMaxMeters
	end

	if isAutoRangeEnabled() then
		return distMeters >= AUTO_RANGE_MIN_METERS and distMeters <= AUTO_RANGE_MAX_METERS
	end

	local limitMeters = math.clamp(tonumber(Config.MaxDistance) or AUTO_RANGE_MAX_METERS, AUTO_RANGE_MIN_METERS, AUTO_RANGE_MAX_METERS)
	return distMeters <= limitMeters
end

local function isModelInTriggerFOV(model, hum, cam, originPos, centerX, centerY, radius)
	if not model or not hum or hum.Health <= 0 then return false end
	local checkParts = {
		model:FindFirstChild("Head"),
		model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso"),
		model:FindFirstChild("HumanoidRootPart")
	}
	for _, p in ipairs(checkParts) do
		if p and p:IsA("BasePart") and isFiniteVector3(p.Position) and isWithinMaxDistance(originPos, p) then
			local worldPt = p.Position
			if CachedTarget == p and CachedAimPos and isFiniteVector3(CachedAimPos) then
				worldPt = CachedAimPos
			end
			local screenPos, onScreen = cam:WorldToViewportPoint(worldPt)
			if onScreen and isFiniteNumber(screenPos.Z) and screenPos.Z > 0 and isFiniteNumber(screenPos.X) and isFiniteNumber(screenPos.Y) then
				local dx = screenPos.X - centerX
				local dy = screenPos.Y - centerY
				if math.sqrt(dx * dx + dy * dy) <= radius then
					if not Config.TriggerBotWallCheck then
						return true
					end
					if isTargetOnVehicleOrMovingPlatform(model, p, hum) then
						return true
					end
					local rayDelta = worldPt - cam.CFrame.Position
					if rayDelta.Magnitude > 0.01 then
						SharedWallParams.FilterDescendantsInstances = { LocalPlayer.Character, model }
						local okWall, wallHit = pcall(function()
							return Workspace:Raycast(cam.CFrame.Position, rayDelta, SharedWallParams)
						end)
						if okWall and (wallHit == nil or isGhostOrNonSolidPart(wallHit.Instance)) then
							return true
						end
					end
				end
			end
		end
	end
	return false
end

local function isEnemyInsideTriggerFOV(cam, originPos, trigFOV)
	if not cam then return false end
	local vp = cam.ViewportSize
	local centerX = vp.X * 0.5
	local centerY = vp.Y * 0.5
	local radius = math.clamp(tonumber(trigFOV) or 6, 1, 10)

	if shouldTargetPlayers() then
		for _, player in ipairs(Players:GetPlayers()) do
			if isEnemyPlayer(player) then
				local char = player.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if hum and isModelInTriggerFOV(char, hum, cam, originPos, centerX, centerY, radius) then
					return true
				end
			end
		end
	end

	if shouldTargetNpcs() then
		local checkedModels = {}
		for _, entry in ipairs(CachedNpcEntries) do
			local npcModel = entry.model
			local hum = entry.hum
			if npcModel and npcModel.Parent and not PlayerCharacterSet[npcModel] and npcModel ~= LocalPlayer.Character and hum and hum.Parent and hum.Health > 0 then
				checkedModels[npcModel] = true
				if isModelInTriggerFOV(npcModel, hum, cam, originPos, centerX, centerY, radius) then
					return true
				end
			end
		end
		for _, obj in ipairs(Workspace:GetChildren()) do
			if obj:IsA("Model") and not checkedModels[obj] and not PlayerCharacterSet[obj] and obj ~= LocalPlayer.Character then
				local hum = obj:FindFirstChildOfClass("Humanoid")
				if hum and hum.Health > 0 and isModelInTriggerFOV(obj, hum, cam, originPos, centerX, centerY, radius) then
					return true
				end
			end
		end
	end

	return false
end

local function fireToolEventsIfPresent(tool)
	if not tool then return false end
	local triggered = false
	for _, desc in ipairs(tool:GetDescendants()) do
		local lower = string.lower(desc.Name or "")
		if string.find(lower, "fire", 1, true) or string.find(lower, "shoot", 1, true) or string.find(lower, "activate", 1, true) or string.find(lower, "trigger", 1, true) then
			if desc:IsA("RemoteEvent") then
				pcall(function()
					desc:FireServer()
					triggered = true
				end)
			elseif desc:IsA("BindableEvent") then
				pcall(function()
					desc:Fire()
					triggered = true
				end)
			end
		end
	end
	return triggered
end

