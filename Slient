local function positionThinSegment(frame, pA, pB, color, thickness)
	if not frame then return end
	if not pA or not pB or not isFiniteNumber(pA.X) or not isFiniteNumber(pA.Y) or not isFiniteNumber(pB.X) or not isFiniteNumber(pB.Y) then
		frame.Visible = false
		return
	end
	local delta = pB - pA
	local dist = delta.Magnitude
	if not isFiniteNumber(dist) or dist <= 1 then
		frame.Visible = false
		return
	end
	local mid = (pA + pB) * 0.5
	local angle = math.deg(math.atan2(delta.Y, delta.X))
	frame.Size = UDim2.new(0, dist, 0, thickness or 1)
	frame.Position = UDim2.new(0, mid.X, 0, mid.Y)
	frame.Rotation = angle
	frame.BackgroundColor3 = color
	frame.Visible = true
end

