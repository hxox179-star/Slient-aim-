local function isLocalPlayerOnVehicleOrMovingPlatform()
	if not Config.AutoSeatToggle then return false end
	local char = LocalPlayer.Character
	if not char then return false end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")

	if hum and ((hum.SeatPart and hum.SeatPart:IsA("BasePart")) or hum.Sit) then
		return true
	end
	if hrp and hrp:IsA("BasePart") then
		local rootAssembly = hrp:GetRootPart()
		if rootAssembly and rootAssembly ~= hrp and rootAssembly:IsA("BasePart") then
			local rootVel = rootAssembly.AssemblyLinearVelocity
			if isFiniteVector3(rootVel) and rootVel.Magnitude > 4 then return true end
		end
		local hrpVel = hrp.AssemblyLinearVelocity
		local moveMag = hum and hum.MoveDirection.Magnitude or 0
		if isFiniteVector3(hrpVel) and moveMag < 0.08 and hrpVel.Magnitude > 5.5 then
			return true
		end
	end
	return false
end

local function syncVehicleAutoState()
	local onMovingVehicleOrPlatform = isLocalPlayerOnVehicleOrMovingPlatform()
	if onMovingVehicleOrPlatform ~= pausedByVehicle then
		pausedByVehicle = onMovingVehicleOrPlatform
		Config.Enabled = not pausedByVehicle and userDesiredEnabled
		refreshSilentToggleButton()
		updateFOVVisual()
	end
end

local function isTargetOnVehicleOrMovingPlatform(model, part, hum)
	if not model then return false end
	if hum and (hum.Sit or (hum.SeatPart and hum.SeatPart:IsA("BasePart"))) then
		return true
	end
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		local vel = hrp.AssemblyLinearVelocity
		if isFiniteVector3(vel) and hum and hum.MoveDirection.Magnitude < 0.05 and vel.Magnitude > 4 then
			return true
		end
	end
	if part and part:IsA("BasePart") then
		local rootAssembly = part:GetRootPart()
		if rootAssembly and rootAssembly ~= part and isFiniteVector3(rootAssembly.AssemblyLinearVelocity) then
			if rootAssembly.AssemblyLinearVelocity.Magnitude > 5 then return true end
		end
	end
	return false
end

local function updateTargetLineAndEsp(cam, startPos2D, worldPoint, isBlockedByWall, bypassWallCheck, modelName, distStuds)
	if not isSilentActive() or not cam or not isFiniteVector3(worldPoint) then
		hideTargetLine()
		return
	end
	local screenPos, onScreen = cam:WorldToViewportPoint(worldPoint)
	if not onScreen or not isFiniteNumber(screenPos.Z) or screenPos.Z <= 0 or not isFiniteNumber(screenPos.X) or not isFiniteNumber(screenPos.Y) then
		hideTargetLine()
		return
	end
	local endPos2D = Vector2.new(screenPos.X, screenPos.Y)
	local delta = endPos2D - startPos2D
	local length = delta.Magnitude
	local lineColor = (bypassWallCheck or not isBlockedByWall) and COLOR_CLEAR_GREEN or COLOR_WALL_WHITE

	if TargetLineFrame then
		if Config.ShowLine and isFiniteNumber(length) and length > 1 then
			TargetLineFrame.Size = UDim2.new(0, length, 0, 1)
			TargetLineFrame.Position = UDim2.new(0, (startPos2D.X + endPos2D.X) * 0.5, 0, (startPos2D.Y + endPos2D.Y) * 0.5)
			TargetLineFrame.Rotation = math.deg(math.atan2(delta.Y, delta.X))
			TargetLineFrame.BackgroundColor3 = lineColor
			TargetLineFrame.Visible = true
		else
			TargetLineFrame.Visible = false
		end
	end

	if EspInfoLabel then
		if Config.ShowEspInfo and modelName then
			EspInfoLabel.Text = string.format("%s | %.0fm", tostring(modelName), tonumber(distStuds) or 0)
			EspInfoLabel.TextColor3 = lineColor
			EspInfoLabel.Position = UDim2.new(0, endPos2D.X, 0, endPos2D.Y - 18)
			EspInfoLabel.Visible = true
		else
			EspInfoLabel.Visible = false
		end
	end
end

local lockedPartByModel = {}
local lockedPartExpireAt = {}

local function pickModelTargetPart(model)
	if not model then return nil end
	local head = model:FindFirstChild("Head")
	local hrp = model:FindFirstChild("HumanoidRootPart")

	if Config.TargetPart == "Random" then
		local hasHead = head and head:IsA("BasePart")
		local hasHrp = hrp and hrp:IsA("BasePart")
		if hasHead and hasHrp then
			local exp = lockedPartExpireAt[model] or 0
			local cached = lockedPartByModel[model]
			if cached and cached.Parent == model and elapsedClock < exp then
				return cached
			end
			local chance = math.clamp(tonumber(Config.HeadshotChance) or 50, 0, 100)
			local picked = (math.random(1, 100) <= chance) and head or hrp
			lockedPartByModel[model] = picked
			lockedPartExpireAt[model] = elapsedClock + 0.45
			return picked
		end
		return (hasHead and head) or (hasHrp and hrp) or nil
	end

	local chosen = model:FindFirstChild(Config.TargetPart) or hrp
	return (chosen and chosen:IsA("BasePart")) and chosen or nil
end

local function pickChestPart(model)
	if not model then return nil end
	for _, name in ipairs({ "UpperTorso", "Torso", "HumanoidRootPart" }) do
		local p = model:FindFirstChild(name)
		if p and p:IsA("BasePart") then return p end
	end
	return nil
end

local function mountGui(gui)
	local mounted = false
	if type(gethui) == "function" then
		local ok, hui = pcall(gethui)
		if ok and typeof(hui) == "Instance" then
			mounted = pcall(function() gui.Parent = hui end)
		end
	end
	if not mounted then
		local okCore, core = pcall(function() return game:GetService("CoreGui") end)
		if okCore and typeof(core) == "Instance" then
			mounted = pcall(function() gui.Parent = core end)
		end
	end
	if not mounted then
		local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 10)
		if playerGui then
			mounted = pcall(function() gui.Parent = playerGui end)
		end
	end
	return mounted
end

