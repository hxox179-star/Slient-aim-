local function sanitizeSaveName(raw)
	local trimmed = tostring(raw or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if trimmed == "" then
		return "Default"
	end
	return trimmed:gsub("[^%w%-%_]", "_")
end

local function hasFileApi()
	return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
end

local function ensureSaveFolder()
	if type(makefolder) == "function" and type(isfolder) == "function" then
		pcall(function()
			if not isfolder(SAVE_FOLDER) then
				makefolder(SAVE_FOLDER)
			end
		end)
	end
end

local function getSaveFilePath(cleanName)
	return SAVE_FOLDER .. "/" .. cleanName .. ".lua"
end

local function serializeValue(val, depth)
	depth = depth or 0
	if depth > 6 then
		return "nil"
	end
	local t = typeof(val)
	if t == "boolean" or t == "number" then
		return tostring(val)
	elseif t == "string" then
		return string.format("%q", val)
	elseif t == "table" then
		local parts = { "{" }
		for k, v in pairs(val) do
			if type(k) == "string" and typeof(v) ~= "function" and typeof(v) ~= "Instance" then
				table.insert(parts, string.format("[%q]=%s,", k, serializeValue(v, depth + 1)))
			end
		end
		table.insert(parts, "}")
		return table.concat(parts)
	end
	return "nil"
end

local function applyConfigTable(tbl)
	if type(tbl) ~= "table" then return end
	local defaults = getDefaultConfig()
	for k, defaultVal in pairs(defaults) do
		if tbl[k] ~= nil and typeof(tbl[k]) == typeof(defaultVal) then
			Config[k] = tbl[k]
		end
	end
	Config.ESPMaxDistance = math.clamp(tonumber(Config.ESPMaxDistance) or 350, 150, 1500)
	userDesiredEnabled = Config.Enabled
end

local function saveConfigByName(rawName)
	local cleanName = sanitizeSaveName(rawName)
	Config.SaveName = cleanName
	local snapshot = {}
	for k, _ in pairs(getDefaultConfig()) do
		snapshot[k] = Config[k]
	end
	MemorySaves[cleanName] = snapshot

	local payload = "return " .. serializeValue(snapshot)
	if hasFileApi() then
		ensureSaveFolder()
		local ok = pcall(writefile, getSaveFilePath(cleanName), payload)
		if not ok then
			setSaveStatus("Đã lưu tạm: " .. cleanName, false)
			return
		end
	end
	setSaveStatus("Đã lưu: " .. cleanName, true)
end

local function saveAutoLoadMeta(enabled, cleanName)
	MemoryAutoLoadName = enabled and cleanName or nil
	if hasFileApi() then
		ensureSaveFolder()
		pcall(writefile, AUTO_LOAD_META_FILE, "return " .. serializeValue({
			enabled = enabled,
			name = cleanName or "Default"
		}))
	end
end

local function loadAutoLoadMeta()
	if hasFileApi() then
		local exists = false
		pcall(function() exists = isfile(AUTO_LOAD_META_FILE) end)
		if exists then
			local ok, raw = pcall(readfile, AUTO_LOAD_META_FILE)
			if ok and type(raw) == "string" and type(loadstring) == "function" then
				local fn = loadstring(raw)
				if type(fn) == "function" then
					local okRun, data = pcall(fn)
					if okRun and type(data) == "table" then
						return data.enabled == true, sanitizeSaveName(data.name)
					end
				end
			end
		end
	end
	return Config.AutoLoadEnabled == true, sanitizeSaveName(Config.SaveName)
end

local function loadConfigByName(rawName, silentMode)
	local cleanName = sanitizeSaveName(rawName)
	if hasFileApi() then
		local path = getSaveFilePath(cleanName)
		local exists = false
		pcall(function() exists = isfile(path) end)
		if exists then
			local ok, raw = pcall(readfile, path)
			if ok and type(raw) == "string" and type(loadstring) == "function" then
				local fn = loadstring(raw)
				if type(fn) == "function" then
					local okRun, data = pcall(fn)
					if okRun and type(data) == "table" then
						applyConfigTable(data)
						Config.SaveName = cleanName
						if not silentMode then
							setSaveStatus("Đã tải save: " .. cleanName, true)
						end
						return true
					end
				end
			end
		end
	end

	if MemorySaves[cleanName] then
		applyConfigTable(MemorySaves[cleanName])
		Config.SaveName = cleanName
		if not silentMode then
			setSaveStatus("Đã tải save: " .. cleanName, true)
		end
		return true
	end

	if not silentMode then
		setSaveStatus("Không tìm thấy: " .. cleanName, false)
	end
	return false
end

local function deleteConfigByName(rawName)
	local cleanName = sanitizeSaveName(rawName)
	local deleted = false
	if MemorySaves[cleanName] then
		MemorySaves[cleanName] = nil
		deleted = true
	end
	if hasFileApi() and type(delfile) == "function" then
		local path = getSaveFilePath(cleanName)
		local exists = false
		pcall(function() exists = isfile(path) end)
		if exists then
			local ok = pcall(delfile, path)
			if ok then deleted = true end
		end
	end
	if deleted then
		setSaveStatus("Đã xóa save: " .. cleanName, true)
	else
		setSaveStatus("Chưa có save tên: " .. cleanName, false)
	end
end

