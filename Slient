	MaxLeadTime = 0.25
}

local function isFiniteNumber(n)
	return typeof(n) == "number" and n == n and n > -math.huge and n < math.huge
end

local function isFiniteVector3(v)
	return typeof(v) == "Vector3"
		and isFiniteNumber(v.X)
		and isFiniteNumber(v.Y)
		and isFiniteNumber(v.Z)
end

local function cyclePreset(list, currentVal, fallback)
	for i, v in ipairs(list) do
		if v == currentVal then
			return list[(i % #list) + 1] or fallback
		end
	end
	return list[1] or fallback
end

local function shouldTargetPlayers()
	return Config.AimMode == "Player" or Config.AimMode == "Player + NPC"
end

local function shouldTargetNpcs()
	return Config.AimMode == "NPC" or Config.AimMode == "Player + NPC"
end

-- Khóa ngắn part ngẫu nhiên theo model để không bị nhảy liên tục giữa đầu và thân
local partLockCache = {}
local partLockUntil = {}
local elapsedClock = 0

local function pickTargetPart(model, now)
	if not model then return nil end
	local head = model:FindFirstChild("Head")
	local hrp = model:FindFirstChild("HumanoidRootPart")

	if Config.TargetPart == "Random" then
		local hasHead = head and head:IsA("BasePart")
		local hasHrp = hrp and hrp:IsA("BasePart")
		if hasHead and hasHrp then
			local cached = partLockCache[model]
			local expire = partLockUntil[model] or 0
			if cached and cached.Parent == model and now < expire then
				return cached
			end
			local chance = math.clamp(tonumber(Config.HeadshotChance) or 50, 0, 100)
			local chosen = (math.random(1, 100) <= chance) and head or hrp
			partLockCache[model] = chosen
			partLockUntil[model] = now + 0.35
			return chosen
		end
		return (hasHead and head) or (hasHrp and hrp) or nil
	end

	local chosen = model:FindFirstChild(Config.TargetPart) or hrp
	return (chosen and chosen:IsA("BasePart")) and chosen or nil
end

local function getOriginPosition(cam)
	local char = LocalPlayer.Character
	if char then
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if hrp and hrp:IsA("BasePart") and isFiniteVector3(hrp.Position) then
			return hrp.Position
		end
	end
	if cam and isFiniteVector3(cam.CFrame.Position) then
		return cam.CFrame.Position
	end
	return Vector3.zero
end

local function isEnemyPlayer(player)
	if player == LocalPlayer then return false end
	if Config.TeamCheck and LocalPlayer.Team and player.Team == LocalPlayer.Team then
		return false
	end
	local char = player.Character
	if not char or not char.Parent or char == LocalPlayer.Character then
		return false
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	return hum ~= nil and hum.Health > 0
end

local wallParams = RaycastParams.new()
wallParams.FilterType = Enum.RaycastFilterType.Exclude

local function isBlockedByWall(cam, model, targetPos)
	if not Config.WallCheck or not cam or not isFiniteVector3(targetPos) then
		return false
	end
	local origin = cam.CFrame.Position
	if not isFiniteVector3(origin) then return false end
	local delta = targetPos - origin
	if not isFiniteVector3(delta) or delta.Magnitude <= 0.05 then
		return false
	end
	wallParams.FilterDescendantsInstances = { LocalPlayer.Character, model }
	local ok, result = pcall(function()
		return Workspace:Raycast(origin, delta, wallParams)
	end)
	return ok and result ~= nil
end

local prevPart = nil
local prevPos = nil
local prevTime = nil
local smoothedVel = Vector3.zero

local function estimateVelocity(part, now)
	if not part or not part:IsA("BasePart") or not isFiniteVector3(part.Position) then
		prevPart = nil
		prevPos = nil
		prevTime = nil
		smoothedVel = Vector3.zero
		return Vector3.zero
	end

	local pos = part.Position
	local assemblyVel = isFiniteVector3(part.AssemblyLinearVelocity) and part.AssemblyLinearVelocity or Vector3.zero
	local vel = assemblyVel

	if prevPart == part and prevPos and prevTime and (now - prevTime) > 0.002 then
		local dt = now - prevTime
		local deltaVel = (pos - prevPos) / dt
		if isFiniteVector3(deltaVel) and deltaVel.Magnitude < 200 then
			vel = assemblyVel:Lerp(deltaVel, 0.55)
		end
	end

	prevPart = part
	prevPos = pos
	prevTime = now
	smoothedVel = isFiniteVector3(vel) and vel or Vector3.zero
	return smoothedVel
end

-- Đoán hướng cân bằng tầm gần (giữ sát mục tiêu để không bắn hụt/dame ảo) và tầm xa (tính lead mượt)
local function computeAimPoint(origin, part, vel)
	if not part or not isFiniteVector3(part.Position) then return nil end
	local basePos = part.Position
	if Config.StraightBullet or not Config.AutoSmartAim or not isFiniteVector3(origin) then
		return basePos
	end

	local dist = (basePos - origin).Magnitude
	local speed = isFiniteVector3(vel) and vel.Magnitude or 0
	if speed < 1.5 then
		return basePos
	end

	-- Trong phạm vi 18 studs: nhắm trực tiếp để ổn định sát thương tầm gần
	if dist <= 18 then
		return basePos
	end

	local nearFactor = math.clamp((dist - 18) / 40, 0, 1)
	local farFactor = math.clamp((dist - 60) / 350, 0, 1)
	local effectiveBulletSpeed = math.max(250, Config.BulletSpeed * (1 - farFactor * 0.15))
	local leadTime = math.clamp((dist / effectiveBulletSpeed) * nearFactor, 0, Config.MaxLeadTime)

	local predicted = basePos + (vel * leadTime)
	return isFiniteVector3(predicted) and predicted or basePos
end

local npcCache = {}
local lastNpcScan = 0

local function refreshNpcCache(now)
	if now - lastNpcScan < 1.5 then return end
	lastNpcScan = now

	local playerChars = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			playerChars[p.Character] = true
		end
	end

	local found = {}
	local myChar = LocalPlayer.Character
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("Model") and obj ~= myChar and not playerChars[obj] then
			local hum = obj:FindFirstChildOfClass("Humanoid")
			local hrp = obj:FindFirstChild("HumanoidRootPart")
			if hum and hum.Health > 0 and hrp and hrp:IsA("BasePart") then
				table.insert(found, obj)
			end
		end
	end
	npcCache = found
end

local function findBestSilentTarget(cam, originPos, centerX, centerY, now)
	if not Config.Enabled or not cam then return nil, nil, 0, false end

	local bestPart = nil
	local bestAimPos = nil
	local bestScreenDist = Config.FOVRadius
	local bestWorldDist = 0
	local bestBlocked = false

	local function checkModel(model)
		if not model or not model.Parent then return end
		local hum = model:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then return end

		local part = pickTargetPart(model, now)
		if not part or not isFiniteVector3(part.Position) then return end

		local worldDist = (part.Position - originPos).Magnitude
		if Config.MaxDistance > 0 and worldDist > Config.MaxDistance then
			return
		end

		local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
		if not onScreen or not isFiniteNumber(screenPos.Z) or screenPos.Z <= 0 then
			return
		end

		local dx = screenPos.X - centerX
		local dy = screenPos.Y - centerY
		local screenDist = math.sqrt(dx * dx + dy * dy)
		if screenDist > bestScreenDist then
			return
		end

		local vel = estimateVelocity(part, now)
		local aimPos = computeAimPoint(originPos, part, vel) or part.Position
		local blocked = isBlockedByWall(cam, model, aimPos)
		if Config.WallCheck and blocked then
			return
		end

		bestScreenDist = screenDist
		bestPart = part
		bestAimPos = aimPos
		bestWorldDist = worldDist
		bestBlocked = blocked
	end

	if shouldTargetPlayers() then
		for _, player in ipairs(Players:GetPlayers()) do
			if isEnemyPlayer(player) then
				checkModel(player.Character)
			end
		end
	end

	if shouldTargetNpcs() then
		refreshNpcCache(now)
		for i = #npcCache, 1, -1 do
			local npc = npcCache[i]
			if npc and npc.Parent then
				checkModel(npc)
			else
				table.remove(npcCache, i)
			end
		end
	end

	return bestPart, bestAimPos, bestWorldDist, bestBlocked
end

