UserInputService.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		isFiringInputHeld = true
	elseif input.UserInputType == Enum.UserInputType.Touch then
		if not activeTouches[input] then
			activeTouches[input] = true
			activeTouchCount = activeTouchCount + 1
		end
		if activeTouchCount >= 7 and not sevenFingerTriggeredThisTouch then
			sevenFingerTriggeredThisTouch = true
			if Config.SevenFingerGesture then
				isMenuHiddenByGesture = not isMenuHiddenByGesture
				applyMenuVisibilityAndMinimize()
			end
		end
		isFiringInputHeld = true
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		isFiringInputHeld = false
	elseif input.UserInputType == Enum.UserInputType.Touch then
		if activeTouches[input] then
			activeTouches[input] = nil
			activeTouchCount = math.max(0, activeTouchCount - 1)
		end
		if activeTouchCount < 7 then sevenFingerTriggeredThisTouch = false end
		if activeTouchCount == 0 then isFiringInputHeld = false end
	end
end)

