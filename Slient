local function captureOriginalRenderState()
	if OriginalRenderState.Captured then return end
	OriginalRenderState.Captured = true
	pcall(function()
		OriginalRenderState.StreamingEnabled = Workspace.StreamingEnabled
		OriginalRenderState.StreamingMinRadius = Workspace.StreamingMinRadius
		OriginalRenderState.StreamingTargetRadius = Workspace.StreamingTargetRadius
		OriginalRenderState.StreamingMaxRadius = Workspace.StreamingMaxRadius
	end)
	pcall(function()
		if LocalPlayer then
			OriginalRenderState.CameraMaxZoomDistance = LocalPlayer.CameraMaxZoomDistance
		end
	end)
	pcall(function()
		if Lighting then
			OriginalRenderState.FogStart = Lighting.FogStart
			OriginalRenderState.FogEnd = Lighting.FogEnd
			for _, obj in ipairs(Lighting:GetDescendants()) do
				if obj:IsA("Atmosphere") then
					OriginalRenderState.AtmosphereDensities[obj] = obj.Density
				end
			end
		end
	end)
end

local function applyFarRenderState(enabled)
	captureOriginalRenderState()
	if enabled then
		pcall(function()
			Workspace.StreamingMinRadius = math.max(OriginalRenderState.StreamingMinRadius or 64, 2048)
			Workspace.StreamingTargetRadius = math.max(OriginalRenderState.StreamingTargetRadius or 256, 4096)
			Workspace.StreamingMaxRadius = math.max(OriginalRenderState.StreamingMaxRadius or 1024, 100000)
			if Workspace.StreamingEnabled then
				pcall(function()
					Workspace.StreamingEnabled = false
				end)
			end
		end)
		pcall(function()
			if LocalPlayer then
				if LocalPlayer.CameraMaxZoomDistance < 100000 then
					LocalPlayer.CameraMaxZoomDistance = 100000
				end
				if LocalPlayer.CameraMinZoomDistance > 0.5 then
					LocalPlayer.CameraMinZoomDistance = 0.5
				end
			end
		end)
		pcall(function()
			if Lighting then
				Lighting.FogStart = 1e7
				Lighting.FogEnd = 1e7
				for _, obj in ipairs(Lighting:GetDescendants()) do
					if obj:IsA("Atmosphere") then
						obj.Density = 0
					end
				end
			end
		end)
	else
		pcall(function()
			if OriginalRenderState.StreamingEnabled ~= nil then
				pcall(function()
					Workspace.StreamingEnabled = OriginalRenderState.StreamingEnabled
				end)
			end
			if OriginalRenderState.StreamingMinRadius ~= nil then
				Workspace.StreamingMinRadius = OriginalRenderState.StreamingMinRadius
			end
			if OriginalRenderState.StreamingTargetRadius ~= nil then
				Workspace.StreamingTargetRadius = OriginalRenderState.StreamingTargetRadius
			end
			if OriginalRenderState.StreamingMaxRadius ~= nil then
				Workspace.StreamingMaxRadius = OriginalRenderState.StreamingMaxRadius
			end
		end)
		pcall(function()
			if LocalPlayer and OriginalRenderState.CameraMaxZoomDistance ~= nil then
				LocalPlayer.CameraMaxZoomDistance = OriginalRenderState.CameraMaxZoomDistance
			end
		end)
		pcall(function()
			if Lighting then
				if OriginalRenderState.FogStart ~= nil then Lighting.FogStart = OriginalRenderState.FogStart end
				if OriginalRenderState.FogEnd ~= nil then Lighting.FogEnd = OriginalRenderState.FogEnd end
				for atm, origDensity in pairs(OriginalRenderState.AtmosphereDensities) do
					if atm and atm.Parent and atm:IsA("Atmosphere") then
						atm.Density = origDensity
					end
				end
			end
		end)
	end
end

