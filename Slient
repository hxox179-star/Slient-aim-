local function switchTab(tabName)
	Config.ActiveTab = tabName
	for name, page in pairs(PageFrames) do
		if page then
			page.Visible = (name == tabName)
			if page.Visible then page.CanvasPosition = Vector2.new(0, 0) end
		end
	end
	for name, btn in pairs(TabButtons) do
		if btn then
			local selected = (name == tabName)
			btn.TextColor3 = selected and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(165, 170, 180)
			btn.BackgroundColor3 = selected and Color3.fromRGB(48, 52, 58) or COLOR_HEADER_DARK
		end
	end
end

local function applyMenuVisibilityAndMinimize()
	if not MainFrame then return end
	if isMenuHiddenByGesture then
		MainFrame.Visible = false
		return
	end
	MainFrame.Visible = true
	if isMinimized then
		if TopBar then TopBar.Visible = false end
		if TabBar then TabBar.Visible = false end
		for _, page in pairs(PageFrames) do
			if page then page.Visible = false end
		end
		if HButton then
			HButton.Visible = true
			HButton.TextColor3 = COLOR_H_ORANGE_TEXT
		end
		MainFrame.BackgroundTransparency = 1
		MainFrame.Size = UDim2.new(0, H_SQUARE_SIZE, 0, H_SQUARE_SIZE)
		if mainStroke then mainStroke.Enabled = false end
		if HButtonStroke then
			HButtonStroke.Color = COLOR_H_BLACK_BORDER
			HButtonStroke.Thickness = 2.4
		end
	else
		if HButton then HButton.Visible = false end
		if TopBar then TopBar.Visible = true end
		if TabBar then TabBar.Visible = true end
		MainFrame.BackgroundTransparency = 0
		MainFrame.Size = UDim2.new(0, MENU_WIDTH, 0, MENU_OPEN_HEIGHT)
		if mainStroke then mainStroke.Enabled = true end
		switchTab(Config.ActiveTab)
	end
end

