local function getActiveSilentAimPoint()
	if CachedTarget and CachedTarget.Parent and isFiniteVector3(CachedTarget.Position) then
		if isAutoRangeEnabled() then
			local originPos = getOriginPosition(Workspace.CurrentCamera)
			local actualMeters = studsToMeters((CachedTarget.Position - originPos).Magnitude)
			if actualMeters < AUTO_RANGE_MIN_METERS or actualMeters > AUTO_RANGE_MAX_METERS then
				return nil
			end
		end
		if CachedAimPos and isFiniteVector3(CachedAimPos) then
			return CachedAimPos
		end
		return CachedTarget.Position
	end
	return nil
end

local function aimDirection(origin, originalDirection, targetPos)
	if not (isFiniteVector3(origin) and isFiniteVector3(targetPos)) then return originalDirection end
	local toTarget = targetPos - origin
	if not isFiniteVector3(toTarget) or toTarget.Magnitude <= 1e-5 then return originalDirection end
	local mag = (isFiniteVector3(originalDirection) and originalDirection.Magnitude > 0) and originalDirection.Magnitude or toTarget.Magnitude
	local dir = toTarget.Unit * mag
	return isFiniteVector3(dir) and dir or originalDirection
end

local function logHookHit(tag)
	if not Config.DebugLog then return end
	if elapsedClock - lastHookLogTime >= 0.5 then
		lastHookLogTime = elapsedClock
