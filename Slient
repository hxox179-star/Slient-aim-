local function isLocalPlayerOnVehicleOrMovingPlatform()
	if not Config.AutoSeatToggle then return false end
	local char = LocalPlayer.Character
	if not char then return false end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")

	if hum and ((hum.SeatPart and hum.SeatPart:IsA("BasePart")) or hum.Sit) then
		return true
	end
	if hrp and hrp:IsA("BasePart") then
		local rootAssembly = hrp:GetRootPart()
		if rootAssembly and rootAssembly ~= hrp and rootAssembly:IsA("BasePart") then
			local rootVel = rootAssembly.AssemblyLinearVelocity
			if isFiniteVector3(rootVel) and rootVel.Magnitude > 4 then return true end
		end
		local hrpVel = hrp.AssemblyLinearVelocity
		local moveMag = hum and hum.MoveDirection.Magnitude or 0
		if isFiniteVector3(hrpVel) and moveMag < 0.08 and hrpVel.Magnitude > 5.5 then
			return true
		end
	end
	return false
end

local function syncVehicleAutoState()
	local onMovingVehicleOrPlatform = isLocalPlayerOnVehicleOrMovingPlatform()
	if onMovingVehicleOrPlatform ~= pausedByVehicle then
		pausedByVehicle = onMovingVehicleOrPlatform
		Config.Enabled = not pausedByVehicle and userDesiredEnabled
		refreshSilentToggleButton()
		updateFOVVisual()
	end
end

local function isTargetOnVehicleOrMovingPlatform(model, part, hum)
	if not model then return false end
	if hum and (hum.Sit or (hum.SeatPart and hum.SeatPart:IsA("BasePart"))) then
		return true
	end
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		local vel = hrp.AssemblyLinearVelocity
		if isFiniteVector3(vel) and hum and hum.MoveDirection.Magnitude < 0.05 and vel.Magnitude > 4 then
			return true
		end
	end
	if part and part:IsA("BasePart") then
		local rootAssembly = part:GetRootPart()
		if rootAssembly and rootAssembly ~= part and isFiniteVector3(rootAssembly.AssemblyLinearVelocity) then
			if rootAssembly.AssemblyLinearVelocity.Magnitude > 5 then return true end
		end
	end
	return false
end

local function pickModelTargetPart(model)
	if not model then return nil end
	local head = model:FindFirstChild("Head")
	local hrp = model:FindFirstChild("HumanoidRootPart")
	local torso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")

	-- Khi bật tầm bắn tự động 1 -> 1000m, ưu tiên bắn vào đầu (Head) đúng khoảng cách thực
	if isAutoRangeEnabled() then
		if head and head:IsA("BasePart") then return head end
		if torso and torso:IsA("BasePart") then return torso end
		if hrp and hrp:IsA("BasePart") then return hrp end
		return nil
	end

	if Config.TargetPart == "Random" then
		local hasHead = head and head:IsA("BasePart")
		local fallbackBody = (hrp and hrp:IsA("BasePart") and hrp) or (torso and torso:IsA("BasePart") and torso) or nil
		if hasHead and fallbackBody then
			local chance = math.clamp(tonumber(Config.HeadshotChance) or 50, 0, 100)
			return (math.random(1, 100) <= chance) and head or fallbackBody
		end
		return (hasHead and head) or fallbackBody or nil
	end

	local chosen = model:FindFirstChild(Config.TargetPart)
	if chosen and chosen:IsA("BasePart") then
		return chosen
	end
	if hrp and hrp:IsA("BasePart") then return hrp end
	if torso and torso:IsA("BasePart") then return torso end
	return (head and head:IsA("BasePart")) and head or nil
end

local function mountGui(gui)
	local mounted = false
	if type(gethui) == "function" then
		local ok, hui = pcall(gethui)
		if ok and hui then
			mounted = pcall(function() gui.Parent = hui end)
		end
	end
	if not mounted then
		local okCore, core = pcall(function() return game:GetService("CoreGui") end)
		if okCore and core then
			mounted = pcall(function() gui.Parent = core end)
		end
	end
	if not mounted then
		local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 10)
		if playerGui then
			mounted = pcall(function() gui.Parent = playerGui end)
		end
	end
	return mounted
end

