local function cyclePreset(list, currentVal, fallback)
	local nextIdx = 1
	for i, v in ipairs(list) do
		if v == currentVal then
			nextIdx = (i % #list) + 1
			break
		end
	end
	return list[nextIdx] or fallback
end

