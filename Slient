local function isWithinSafeServerAngle(cam, worldPos)
	if not Config.SafeAngleClamp or not cam then return true end
	local lookDir = cam.CFrame.LookVector
	local toTarget = worldPos - cam.CFrame.Position
	if toTarget.Magnitude <= 14 then return true end
	local dot = math.clamp(lookDir.Unit:Dot(toTarget.Unit), -1, 1)
	local angleDeg = math.deg(math.acos(dot))
	local limitDeg = math.max(tonumber(Config.MaxSafeAngleDeg) or 28, 65)
	return angleDeg <= limitDeg
end

local function evaluateCandidateModel(model, hum, cam, originPos, centerX, centerY, shortestDistance, partPicker, fovLimit, wallFlag, maxMetersFilter)
	local part = partPicker(model)
	if not part or not part:IsA("BasePart") or not isFiniteVector3(part.Position) then
		return nil, shortestDistance
	end
	if not isWithinMaxDistance(originPos, part, maxMetersFilter) then
		return nil, shortestDistance
	end
	if not isWithinSafeServerAngle(cam, part.Position) then
		return nil, shortestDistance
	end
	local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
	if onScreen and isFiniteNumber(screenPos.Z) and screenPos.Z > 0 and isFiniteNumber(screenPos.X) and isFiniteNumber(screenPos.Y) then
		local dx = screenPos.X - centerX
		local dy = screenPos.Y - centerY
		local dist = math.sqrt(dx * dx + dy * dy)
		if dist <= math.min(shortestDistance, fovLimit) and isClearPathWithWallFlag(model, part, part.Position, hum, wallFlag) then
			return part, dist
		end
	end
	return nil, shortestDistance
end

local function scanCandidatesAtRange(cam, originPos, centerX, centerY, partPicker, fovLimit, wallFlag, maxMetersFilter)
	local closestPart = nil
	local shortestDistance = fovLimit
	local checkPlayers = shouldTargetPlayers()
	local checkNpcs = shouldTargetNpcs()

	if checkPlayers then
		for _, player in ipairs(Players:GetPlayers()) do
			if isEnemyPlayer(player) then
				local char = player.Character
				local hum = char:FindFirstChildOfClass("Humanoid")
				local pickedPart, newDist = evaluateCandidateModel(char, hum, cam, originPos, centerX, centerY, shortestDistance, partPicker, fovLimit, wallFlag, maxMetersFilter)
				if pickedPart then
					closestPart = pickedPart
					shortestDistance = newDist
				end
			end
		end
	end

	if checkNpcs then
		for i = #CachedNpcEntries, 1, -1 do
			local entry = CachedNpcEntries[i]
			local npcModel = entry.model
			local hum = entry.hum
			if npcModel and npcModel.Parent and not PlayerCharacterSet[npcModel] and npcModel ~= LocalPlayer.Character and hum and hum.Parent and hum.Health > 0 then
				local pickedPart, newDist = evaluateCandidateModel(npcModel, hum, cam, originPos, centerX, centerY, shortestDistance, partPicker, fovLimit, wallFlag, maxMetersFilter)
				if pickedPart then
					closestPart = pickedPart
					shortestDistance = newDist
				end
			else
				table.remove(CachedNpcEntries, i)
			end
		end
	end

	return closestPart
end

local function findBestTarget(partPicker, fovLimit, wallFlag)
	local cam = Workspace.CurrentCamera
	if not cam then
		CachedMatchedMeter = 0
		return nil
	end

	local vp = cam.ViewportSize
	local centerX = vp.X * 0.5
	local centerY = vp.Y * 0.5
	local originPos = getOriginPosition(cam)

	if shouldTargetNpcs() and (elapsedClock - lastNpcScanTime >= (Config.FarRender and 0.6 or 1.2)) then
		lastNpcScanTime = elapsedClock
		triggerAsyncNpcScan()
	end

	-- Quét tuần tự theo số tăng dần từ 1m -> 1000m (1, 2, 3, ... 1000) để khóa đầu đúng tầm khoảng cách
	if isAutoRangeEnabled() then
		local stepOffset = math.floor(elapsedClock) % 25
		for m = AUTO_RANGE_MIN_METERS, AUTO_RANGE_MAX_METERS do
			local probeMeters = m
			if m > 60 then
				probeMeters = math.min(AUTO_RANGE_MAX_METERS, m + stepOffset)
			end
			local hitPart = scanCandidatesAtRange(cam, originPos, centerX, centerY, partPicker, fovLimit, true, probeMeters)
			if hitPart then
				CachedMatchedMeter = studsToMeters((hitPart.Position - originPos).Magnitude)
				return hitPart
			end
			if probeMeters >= AUTO_RANGE_MAX_METERS then
				break
			end
		end
		CachedMatchedMeter = 0
		return nil
	end

	local limitMeters = math.clamp(tonumber(Config.MaxDistance) or AUTO_RANGE_MAX_METERS, AUTO_RANGE_MIN_METERS, AUTO_RANGE_MAX_METERS)
	local found = scanCandidatesAtRange(cam, originPos, centerX, centerY, partPicker, fovLimit, wallFlag, limitMeters)
	CachedMatchedMeter = found and studsToMeters((found.Position - originPos).Magnitude) or 0
	return found
end

