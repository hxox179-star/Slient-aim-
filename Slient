local function triggerAsyncNpcScan()
	if isScanningNpc or not shouldTargetNpcs() then return end
	isScanningNpc = true
	task.spawn(function()
		local newEntries = {}
		local myChar = LocalPlayer.Character
		pcall(function()
			for _, obj in ipairs(Workspace:GetChildren()) do
				if obj:IsA("Model") and obj ~= myChar and not PlayerCharacterSet[obj] then
					local hum = obj:FindFirstChildOfClass("Humanoid")
					if hum and hum.Health > 0 then
						table.insert(newEntries, { model = obj, hum = hum })
					end
				end
			end
			if #newEntries == 0 then
				for _, obj in ipairs(Workspace:GetDescendants()) do
					if obj:IsA("Model") and obj ~= myChar and not PlayerCharacterSet[obj] then
						local hum = obj:FindFirstChildOfClass("Humanoid")
						if hum and hum.Health > 0 then
							table.insert(newEntries, { model = obj, hum = hum })
						end
					end
				end
			end
		end)
		CachedNpcEntries = newEntries
		isScanningNpc = false
	end)
end

local function estimateTargetVelocity(part, dt, distance)
	if not part or not part:IsA("BasePart") or not isFiniteVector3(part.Position) then
		return Vector3.zero
	end
	local currentPos = part.Position
	local assemblyVel = part.AssemblyLinearVelocity
	if not isFiniteVector3(assemblyVel) then assemblyVel = Vector3.zero end
	local estimatedVel = assemblyVel

	local sampleDt = (prevSampleTime and (elapsedClock - prevSampleTime) > 0.001) and (elapsedClock - prevSampleTime) or dt
	if prevTargetPart == part and prevTargetPos and sampleDt and sampleDt > 0.001 then
		local frameVel = (currentPos - prevTargetPos) / sampleDt
		if isFiniteVector3(frameVel) and frameVel.Magnitude < 220 then
			local farFactor = Config.AutoSmartAim and math.clamp(((distance or 0) - 80) / 350, 0, 1) or 0
			local blend = 0.65 - (farFactor * 0.2)
			estimatedVel = (assemblyVel.Magnitude > frameVel.Magnitude * 0.55) and assemblyVel:Lerp(frameVel, blend) or frameVel
		end
	end

	prevTargetPart = part
	prevTargetPos = currentPos
	prevTargetVel = estimatedVel
	prevSampleTime = elapsedClock
	return isFiniteVector3(estimatedVel) and estimatedVel or Vector3.zero
end

local function computePredictedPosition(origin, part, velocity)
	if not part or not isFiniteVector3(part.Position) then return nil end
	local basePos = part.Position
	if Config.StraightBullet or not Config.AutoSmartAim or not isFiniteVector3(origin) then
		return basePos
	end

	local dist = (basePos - origin).Magnitude
	local moveSpeed = isFiniteVector3(velocity) and velocity.Magnitude or 0
	if moveSpeed < 1.5 then return basePos end

	local nearScale = math.clamp((dist - 18) / 36, 0, 1)
	if nearScale <= 0.03 then return basePos end

	local farFactor = math.clamp((dist - 60) / 380, 0, 1)
	local effectiveSpeed = math.max(240, Config.BulletSpeed * (1 - farFactor * 0.18))
	local rawLead = dist / effectiveSpeed
	local dynamicMaxLead = math.min(Config.MaxLeadTime, 0.12 + (farFactor * 0.16))
	local leadTime = math.clamp(rawLead * nearScale, 0, dynamicMaxLead)

	local sampleDt = (prevSampleTime and (elapsedClock - prevSampleTime) > 0.002) and (elapsedClock - prevSampleTime) or 0.016
	local accelTerm = Vector3.zero
	if prevTargetVel and isFiniteVector3(prevTargetVel) and sampleDt > 0.002 then
		local accel = (velocity - prevTargetVel) / sampleDt
		if isFiniteVector3(accel) and accel.Magnitude < 120 then
			accelTerm = accel * (0.5 * leadTime * leadTime) * 0.25
		end
	end

	local predicted = basePos + (velocity * leadTime) + accelTerm
	return isFiniteVector3(predicted) and predicted or basePos
end

local function isWithinMaxDistance(origin, part)
	if not part or not isFiniteVector3(part.Position) then return true end
	local dist = (part.Position - origin).Magnitude
	if Config.MaxDistance <= 0 then
		if Config.AutoSmartAim then return dist <= 10000 end
		return true
	end
	return dist <= Config.MaxDistance
end

local function isEnemyPlayer(player)
	if player == LocalPlayer then return false end
	if Config.TeamCheck and LocalPlayer.Team and player.Team == LocalPlayer.Team then return false end
	local char = player.Character
	if not char or not char.Parent or char == LocalPlayer.Character then return false end
	local hum = char:FindFirstChildOfClass("Humanoid")
	return hum ~= nil and hum.Health > 0
end

local function checkWallOcclusion(model, targetPart, aimPos, hum)
	local bypassWall = isTargetOnVehicleOrMovingPlatform(model, targetPart, hum)
	if bypassWall then return false, true end

	local cam = Workspace.CurrentCamera
	if not cam or not isFiniteVector3(cam.CFrame.Position) then return false, false end

	local origin = cam.CFrame.Position
	local goalPos = (aimPos and isFiniteVector3(aimPos)) and aimPos or targetPart.Position
	local direction = goalPos - origin
	if not isFiniteVector3(direction) or direction.Magnitude <= 0.001 then return false, false end

	SharedWallParams.FilterDescendantsInstances = { LocalPlayer.Character, model }
	local ok, result = pcall(function()
		return Workspace:Raycast(origin, direction, SharedWallParams)
	end)
	if not ok then return false, false end
	return result ~= nil, false
end

local function isClearPathWithWallFlag(model, targetPart, aimPos, hum, wallFlag)
	if not wallFlag then return true end
	local isBlocked, bypassWall = checkWallOcclusion(model, targetPart, aimPos, hum)
	if bypassWall then return true end
	return not isBlocked
end

local function isWithinSafeServerAngle(cam, worldPos)
	if not Config.SafeAngleClamp or not cam then return true end
	local lookDir = cam.CFrame.LookVector
	local toTarget = worldPos - cam.CFrame.Position
	if toTarget.Magnitude <= 14 then return true end
	local dot = math.clamp(lookDir.Unit:Dot(toTarget.Unit), -1, 1)
	local angleDeg = math.deg(math.acos(dot))
	return angleDeg <= Config.MaxSafeAngleDeg
end

local function evaluateCandidateModel(model, hum, cam, originPos, centerX, centerY, shortestDistance, partPicker, fovLimit, wallFlag)
	local part = partPicker(model)
	if not part or not part:IsA("BasePart") or not isFiniteVector3(part.Position) then
		return nil, shortestDistance
	end
	if not isWithinMaxDistance(originPos, part) then
		return nil, shortestDistance
	end
	if not isWithinSafeServerAngle(cam, part.Position) then
		return nil, shortestDistance
	end
	local screenPos, onScreen = cam:WorldToViewportPoint(part.Position)
	if onScreen and isFiniteNumber(screenPos.Z) and screenPos.Z > 0 and isFiniteNumber(screenPos.X) and isFiniteNumber(screenPos.Y) then
		local dx = screenPos.X - centerX
		local dy = screenPos.Y - centerY
		local dist = math.sqrt(dx * dx + dy * dy)
		if dist <= math.min(shortestDistance, fovLimit) and isClearPathWithWallFlag(model, part, part.Position, hum, wallFlag) then
			return part, dist
		end
	end
	return nil, shortestDistance
end

local function findBestTarget(partPicker, fovLimit, wallFlag)
	local cam = Workspace.CurrentCamera
	if not cam then return nil end

	local vp = cam.ViewportSize
	local centerX = vp.X * 0.5
	local centerY = vp.Y * 0.5
	local originPos = getOriginPosition(cam)
	local closestPart = nil
	local shortestDistance = fovLimit

	local checkPlayers = shouldTargetPlayers()
	local checkNpcs = shouldTargetNpcs()

	if checkPlayers or checkNpcs then rebuildPlayerCharacterSet() end

	if checkPlayers then
		for _, player in ipairs(Players:GetPlayers()) do
			if isEnemyPlayer(player) then
				local char = player.Character
				local hum = char:FindFirstChildOfClass("Humanoid")
				local pickedPart, newDist = evaluateCandidateModel(char, hum, cam, originPos, centerX, centerY, shortestDistance, partPicker, fovLimit, wallFlag)
				if pickedPart then
					closestPart = pickedPart
					shortestDistance = newDist
				end
			end
		end
	end

	if checkNpcs then
		if elapsedClock - lastNpcScanTime >= 1.2 then
			lastNpcScanTime = elapsedClock
			triggerAsyncNpcScan()
		end
		for i = #CachedNpcEntries, 1, -1 do
			local entry = CachedNpcEntries[i]
			local npcModel = entry.model
			local hum = entry.hum
			if npcModel and npcModel.Parent and not PlayerCharacterSet[npcModel] and npcModel ~= LocalPlayer.Character and hum and hum.Parent and hum.Health > 0 then
				local pickedPart, newDist = evaluateCandidateModel(npcModel, hum, cam, originPos, centerX, centerY, shortestDistance, partPicker, fovLimit, wallFlag)
				if pickedPart then
					closestPart = pickedPart
					shortestDistance = newDist
				end
			else
				table.remove(CachedNpcEntries, i)
			end
		end
	end

	return closestPart
end

local function applyChestAimbotWhenFiring(cam, targetPart, aimPos, stickPercent)
	if not cam or not targetPart or not aimPos or not isFiniteVector3(aimPos) then return end
	if not isCurrentlyFiring() then return end

	local cf = cam.CFrame
	if not isFiniteVector3(cf.Position) then return end

	local desiredLook = aimPos - cf.Position
	if not isFiniteVector3(desiredLook) or desiredLook.Magnitude <= 1e-4 then return end

	local targetCFrame = CFrame.lookAt(cf.Position, cf.Position + desiredLook.Unit)
	local clampedStick = math.clamp(tonumber(stickPercent) or 70, 10, 100)

	if clampedStick >= 100 then
		cam.CFrame = targetCFrame
	else
		local alpha = math.clamp((clampedStick / 100) * 0.65, 0.06, 0.65)
		cam.CFrame = cf:Lerp(targetCFrame, alpha)
	end
end

local function toScreen2D(cam, worldPos)
	if not cam or not isFiniteVector3(worldPos) then return nil end
	local sp, onScreen = cam:WorldToViewportPoint(worldPos)
	if not onScreen or not isFiniteNumber(sp.Z) or sp.Z <= 0 or not isFiniteNumber(sp.X) or not isFiniteNumber(sp.Y) then
		return nil
	end
	return Vector2.new(sp.X, sp.Y)
end

local function getHealthColor(hpRatio)
	if hpRatio > 0.6 then return COLOR_HP_GREEN
	elseif hpRatio >= 0.3 then return COLOR_HP_ORANGE
	else return COLOR_HP_RED end
end

local function renderEspForModels(cam, originPos)
	if not isSilentActive() or not cam then
		hideAllEspVisuals()
		return
	end
	local showBox = Config.ShowBox2D
	local showHp = Config.ShowHealthBar and showBox
	local showTop = Config.ShowTopLine
	local showBot = Config.ShowBottomLine
	local showSkel = Config.ShowSkeleton
	if not showBox and not showTop and not showBot and not showSkel then
		hideAllEspVisuals()
		return
	end

	local vp = cam.ViewportSize
	local topCenter = Vector2.new(vp.X * 0.5, 2)
	local botCenter = Vector2.new(vp.X * 0.5, vp.Y - 2)
	local activeKeys = {}
	local idx = 0

	local function processModel(model, hum)
		if not model or not model.Parent or not hum or hum.Health <= 0 then return end
		local hrp = model:FindFirstChild("HumanoidRootPart")
		local head = model:FindFirstChild("Head")
		local anchorPart = (hrp and hrp:IsA("BasePart") and hrp) or (head and head:IsA("BasePart") and head)
		if not anchorPart or not isFiniteVector3(anchorPart.Position) then return end

		local dist = (anchorPart.Position - originPos).Magnitude
		local inBoxRange = showBox and (dist <= Config.BoxMaxDistance)
		local inLineSkelRange = (showTop or showBot or showSkel) and (dist <= Config.LineSkeletonMaxDistance)
		if not inBoxRange and not inLineSkelRange then return end

		local headTopWorld = (head and head:IsA("BasePart") and isFiniteVector3(head.Position))
			and (head.Position + Vector3.new(0, 0.72, 0))
			or (anchorPart.Position + Vector3.new(0, 2.35, 0))
		local footWorld = anchorPart.Position - Vector3.new(0, 3.1, 0)

		local topPt = toScreen2D(cam, headTopWorld)
		local botPt = toScreen2D(cam, footWorld)
		local centerPt = toScreen2D(cam, anchorPart.Position)
		if not topPt or not botPt or not centerPt then return end

		local boxHeight = math.max(14, math.abs(botPt.Y - topPt.Y))
		local boxWidth = math.max(10, boxHeight * 0.56)
		local boxLeft = centerPt.X - (boxWidth * 0.5)
		local boxTop = topPt.Y

		local isBlocked, bypassWall = checkWallOcclusion(model, anchorPart, anchorPart.Position, hum)
		local espColor = (bypassWall or not isBlocked) and COLOR_CLEAR_GREEN or COLOR_WALL_WHITE

		idx = idx + 1
		local key = tostring(idx)
		activeKeys[key] = true
		local visual = getOrCreateEspVisual(key)
		if not visual then return end

		if visual.boxFrame then
			if inBoxRange then
				visual.boxFrame.Position = UDim2.new(0, boxLeft, 0, boxTop)
				visual.boxFrame.Size = UDim2.new(0, boxWidth, 0, boxHeight)
				if visual.boxStroke then visual.boxStroke.Color = espColor end
				visual.boxFrame.Visible = true
			else
				visual.boxFrame.Visible = false
			end
		end

		if visual.hpBg then
			if inBoxRange and showHp then
				local maxHp = math.max(1, tonumber(hum.MaxHealth) or 100)
				local ratio = math.clamp((tonumber(hum.Health) or 0) / maxHp, 0, 1)
				visual.hpBg.Position = UDim2.new(0, boxLeft - 6, 0, boxTop)
				visual.hpBg.Size = UDim2.new(0, 4, 0, boxHeight)
				visual.hpBg.Visible = true
				if visual.hpFill then
					visual.hpFill.Size = UDim2.new(1, 0, ratio, 0)
					visual.hpFill.BackgroundColor3 = getHealthColor(ratio)
				end
			else
				visual.hpBg.Visible = false
			end
		end

		if inLineSkelRange and showTop then
			positionThinSegment(visual.topLine, topCenter, topPt, espColor, 1)
		elseif visual.topLine then
			visual.topLine.Visible = false
		end

		if inLineSkelRange and showBot then
			positionThinSegment(visual.botLine, botCenter, botPt, espColor, 1)
		elseif visual.botLine then
			visual.botLine.Visible = false
		end

		if inLineSkelRange and showSkel then
			local torsoPart = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso") or hrp
			local hipPart = model:FindFirstChild("LowerTorso") or hrp
			local lArm = model:FindFirstChild("LeftLowerArm") or model:FindFirstChild("Left Arm") or model:FindFirstChild("LeftUpperArm")
			local rArm = model:FindFirstChild("RightLowerArm") or model:FindFirstChild("Right Arm") or model:FindFirstChild("RightUpperArm")
			local lLeg = model:FindFirstChild("LeftLowerLeg") or model:FindFirstChild("Left Leg") or model:FindFirstChild("LeftUpperLeg")
			local rLeg = model:FindFirstChild("RightLowerLeg") or model:FindFirstChild("Right Leg") or model:FindFirstChild("RightUpperLeg")

			local headWorld = (head and head:IsA("BasePart") and isFiniteVector3(head.Position))
				and head.Position
				or (anchorPart.Position + Vector3.new(0, 1.65, 0))
			local neckWorld = (torsoPart and torsoPart:IsA("BasePart") and isFiniteVector3(torsoPart.Position))
				and (torsoPart.Position + Vector3.new(0, torsoPart.Size.Y * 0.48, 0))
				or headWorld:Lerp(anchorPart.Position, 0.35)

			local pHead = toScreen2D(cam, headWorld) or topPt
			local pNeck = toScreen2D(cam, neckWorld) or pHead
			local pTorso = torsoPart and torsoPart:IsA("BasePart") and toScreen2D(cam, torsoPart.Position) or centerPt
			local pHip = hipPart and hipPart:IsA("BasePart") and toScreen2D(cam, hipPart.Position) or botPt
			local pLArm = lArm and lArm:IsA("BasePart") and toScreen2D(cam, lArm.Position) or pNeck
			local pRArm = rArm and rArm:IsA("BasePart") and toScreen2D(cam, rArm.Position) or pNeck
			local pLLeg = lLeg and lLeg:IsA("BasePart") and toScreen2D(cam, lLeg.Position) or botPt
			local pRLeg = rLeg and rLeg:IsA("BasePart") and toScreen2D(cam, rLeg.Position) or botPt

			if visual.headDot then
				local dotSize = math.clamp(math.floor(boxHeight * 0.16), 5, 16)
				visual.headDot.Size = UDim2.new(0, dotSize, 0, dotSize)
				visual.headDot.Position = UDim2.new(0, pHead.X, 0, pHead.Y)
				visual.headDot.BackgroundColor3 = espColor
				visual.headDot.BackgroundTransparency = 0
				visual.headDot.Visible = true
			end

			local segs = {
				{ pHead, pNeck },
				{ pNeck, pTorso },
				{ pTorso, pHip },
				{ pNeck, pLArm },
				{ pNeck, pRArm },
				{ pHip, pLLeg },
				{ pHip, pRLeg },
				{ pLLeg, botPt },
				{ pRLeg, botPt },
				{ pLArm, pTorso },
				{ pRArm, pTorso }
			}
			for bIdx, bone in ipairs(visual.bones) do
				local pair = segs[bIdx]
				if pair then positionThinSegment(bone, pair[1], pair[2], espColor, 1)
				else bone.Visible = false end
			end
		else
			if visual.headDot then visual.headDot.Visible = false end
			for _, bone in ipairs(visual.bones) do bone.Visible = false end
		end
	end

	if shouldTargetPlayers() then
		for _, player in ipairs(Players:GetPlayers()) do
			if isEnemyPlayer(player) and idx < 28 then
				local char = player.Character
				processModel(char, char and char:FindFirstChildOfClass("Humanoid"))
			end
		end
	end

	if shouldTargetNpcs() then
		for _, entry in ipairs(CachedNpcEntries) do
			if idx >= 28 then break end
			if entry and entry.model and entry.model.Parent and not PlayerCharacterSet[entry.model] and entry.model ~= LocalPlayer.Character then
				processModel(entry.model, entry.hum)
			end
		end
	end

	for key, entry in pairs(EspVisualPool) do
		if not activeKeys[key] then
			if entry.boxFrame then entry.boxFrame.Visible = false end
			if entry.hpBg then entry.hpBg.Visible = false end
			if entry.topLine then entry.topLine.Visible = false end
			if entry.botLine then entry.botLine.Visible = false end
			if entry.headDot then entry.headDot.Visible = false end
			if entry.bones then
				for _, bone in ipairs(entry.bones) do bone.Visible = false end
			end
		end
	end
end

local function updateRainbowUI()
	if elapsedClock - lastRainbowUpdateTime < 0.03 then return end
	lastRainbowUpdateTime = elapsedClock
	if isMinimized then
		if HButtonStroke then HButtonStroke.Color = COLOR_H_BLACK_BORDER end
		if HButton then HButton.TextColor3 = COLOR_H_ORANGE_TEXT end
		return
	end
	if mainStroke then
		mainStroke.Color = Color3.fromHSV((elapsedClock * 0.25) % 1, 1, 1)
	end
end

